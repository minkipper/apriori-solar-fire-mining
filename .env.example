# Upstage Solar API Key
# https://console.upstage.ai/ 에서 발급받은 API 키를 입력하세요.
UPSTAGE_API_KEY=your_upstage_api_key_here

# (선택사항) 모델 지정: solar-pro4 (기본값) 또는 solar-mini4
UPSTAGE_MODEL=solar-pro4

# V-World (브이월드) Open API Key (전국 GIS건물통합정보 · 도로명건물 · 배경지도 · 주소검색 연동)
# https://www.vworld.kr -> 오픈API -> 인증키 발급
VWORLD_API_KEY=your_vworld_api_key_here
VWORLD_DOMAIN=http://localhost:8000
